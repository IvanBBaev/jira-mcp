{
  "name": "jira-mcp-ai",
  "version": "0.0.0",
  "private": true,
  "mcpName": "io.github.IvanBBaev/jira-mcp-ai",
  "description": "MCP server for Jira Cloud: JQL search, issue reads and gated writes, comments, worklogs, boards and sprints. API-token auth, plan/apply write safety, read-only by default, no telemetry.",
  "license": "MIT",
  "author": "Ivan Baev <ivanbbaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/jira-mcp.git"
  },
  "homepage": "https://ivanbbaev.github.io/jira-mcp/",
  "bugs": {
    "url": "https://github.com/IvanBBaev/jira-mcp/issues"
  },
  "type": "module",
  "bin": {
    "jira-mcp-ai": "./bin/jira-mcp-ai.cjs"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    "build",
    "CHANGELOG.md",
    "!build/**/*.map",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/testing",
    "!build/core/fakes"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./build/testing/network-fence.js --test \"build/**/*.test.js\"",
    "test:coverage": "c8 node --import ./build/testing/network-fence.js --test \"build/**/*.test.js\"",
    "coverage": "npm run build && npm run test:coverage",
    "docs:lint": "node scripts/docs-lint.mjs",
    "readme": "npm run build && node scripts/generate-readme.mjs",
    "tarball": "node scripts/check-tarball.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:publish": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run tarball && npm run test:coverage && npm run docs:lint",
    "check": "npm run check:publish && npm run audit:prod",
    "prepublishOnly": "npm run check:publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "jira-cloud",
    "atlassian",
    "jql",
    "issue-tracker",
    "llm",
    "ai"
  ]
}
