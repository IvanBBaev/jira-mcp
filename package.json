{
  "name": "jira-mcp-ai",
  "version": "0.0.0",
  "private": true,
  "mcpName": "io.github.IvanBBaev/jira-mcp-ai",
  "description": "Local-first TypeScript MCP server for Jira Cloud: JQL search, issue read and write, transitions, comments, worklogs, project and field metadata, users, boards and sprints — headless API-token auth, read-only by default, plan-and-apply write safety, no telemetry.",
  "license": "MIT",
  "author": "Ivan Baev <ivanbbaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/jira-mcp.git"
  },
  "homepage": "https://github.com/IvanBBaev/jira-mcp#readme",
  "bugs": {
    "url": "https://github.com/IvanBBaev/jira-mcp/issues"
  },
  "type": "module",
  "bin": {
    "jira-mcp-ai": "./bin/jira-mcp-ai.cjs"
  },
  "main": "./build/index.js",
  "files": [
    "bin",
    "build",
    "!build/**/*.map",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/testing",
    "!build/core/fakes"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./build/testing/network-fence.js --test \"build/**/*.test.js\"",
    "coverage": "npm run build && c8 node --import ./build/testing/network-fence.js --test \"build/**/*.test.js\"",
    "docs:lint": "node scripts/docs-lint.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test && npm run docs:lint && npm run audit:prod",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "jira-cloud",
    "atlassian",
    "jql",
    "issue-tracker",
    "llm",
    "ai"
  ],
  "trademark": "This is an independent, community-built project and is not affiliated with, endorsed by, or sponsored by Atlassian Pty Ltd. Jira, Atlassian and related marks are trademarks of Atlassian, used here only nominatively to indicate what this server connects to."
}
