# jira-mcp-ai — example environment file
#
# Copy to one of the locations the server searches, in this order:
#   1. the path in JIRA_ENV_FILE
#   2. $XDG_CONFIG_HOME/jira-mcp-ai/.env  (default ~/.config/jira-mcp-ai/.env)
#   3. a project-local .env               (development only)
# Loaded with Node's process.loadEnvFile() — there is no dotenv dependency.
#
# Placeholders only. Never commit a real token: `.env` is git-ignored,
# `.env.example` is not.
#
# Defaults are deliberately NOT repeated here. docs/CONFIGURATION.md owns every
# name and default; a copy in this file would silently rot. Commented-out lines
# below show the shape of the value, not its default.

# ---------------------------------------------------------------------------
# Core credentials (required)
# ---------------------------------------------------------------------------

# Site key, host, or full URL: "mycompany", "mycompany.atlassian.net",
# or "https://mycompany.atlassian.net".
JIRA_SITE=mycompany

# Atlassian account email used for Basic auth.
JIRA_EMAIL=me@example.com

# Atlassian API token — create at id.atlassian.com > Security > API tokens.
# Secret: registered with the redactor, never logged.
JIRA_API_TOKEN=replace-me

# ---------------------------------------------------------------------------
# OAuth 2.0 (3LO) — an alternative to JIRA_EMAIL + JIRA_API_TOKEN
# ---------------------------------------------------------------------------
#
# Switching this on replaces the two variables above, not JIRA_SITE: the site
# still says which Jira this server talks to. Credentials come from the token
# store `jira-mcp-ai login` writes, so run login once after setting these.
# Everything below is inert while the mode stays basic.
# See docs/AUTH.md for the flow and docs/CONFIGURATION.md for the defaults.

# basic (default) | oauth | pat
# JIRA_AUTH_MODE=oauth

# Jira Data Center — an unverified read-only preview (see docs/CONFIGURATION.md).
# datacenter needs JIRA_AUTH_MODE=pat, a JIRA_SITE listed in JIRA_ALLOWED_HOSTS
# (a context path such as https://jira.example.com/jira is kept), and
# JIRA_DATACENTER_PREVIEW=true to start. Run `jira-mcp-ai doctor` first.
# JIRA_DEPLOYMENT=datacenter
# JIRA_PAT=replace-me
# JIRA_DATACENTER_PREVIEW=true

# The OAuth 2.0 (3LO) app consent is asked for — create it at
# developer.atlassian.com/console/myapps/. Both are required in oauth mode; the
# secret is a secret (registered with the redactor) even though the flow uses
# PKCE, because Atlassian authenticates the client on the token endpoint.
# JIRA_OAUTH_CLIENT_ID=replace-me
# JIRA_OAUTH_CLIENT_SECRET=replace-me

# Comma list of scopes to ask consent for. Leave unset unless you know why you
# are narrowing or widening it — editing this after a successful login forces a
# re-consent, so you have to run login again.
# JIRA_OAUTH_SCOPES=read:jira-work,write:jira-work,offline_access

# Pin the flow to one Jira Cloud site by id. Unset (the default) means the site
# is discovered on every run; set this only when the account can reach several
# and you want one of them. login prints the id.
# JIRA_OAUTH_CLOUD_ID=00000000-0000-0000-0000-000000000000

# Where login writes the token store (created 0600). Defaults to oauth.json in
# the config directory ($XDG_CONFIG_HOME/jira-mcp-ai, default
# ~/.config/jira-mcp-ai) — not beside an env file named by JIRA_ENV_FILE. A
# leading ~ is expanded like JIRA_ENV_FILE.
# JIRA_OAUTH_TOKEN_FILE=~/.config/jira-mcp-ai/oauth.json

# Loopback port login binds for the redirect callback. It must match the
# callback URL registered on the app character for character.
# JIRA_OAUTH_REDIRECT_PORT=<port>

# Where the flow talks to Atlassian: the authorization server and the OAuth API
# gateway. Both must be bare https origins (no path, query or credentials).
# They exist so the offline test harness can point the flow at a local fake —
# against a real tenant there is no reason to set either. The gateway carries
# every Jira call, so its host must not be loopback, private, link-local or a
# metadata address: those are refused even when allowlisted.
# JIRA_OAUTH_AUTH_ORIGIN=https://auth.fake-atlassian.test:8443
# JIRA_OAUTH_GATEWAY_ORIGIN=https://gateway.fake-atlassian.test:8443

# ---------------------------------------------------------------------------
# Credential hygiene (optional)
# ---------------------------------------------------------------------------

# ISO date the token expires; doctor warns as the date approaches. Describes the
# API token above, so oauth mode ignores it (and says so at startup).
# JIRA_TOKEN_EXPIRES=2027-01-31

# Comma list of extra allowed hosts (Server/DC or vanity domains).
# Exact host or anchored /^regex$/ — a suffix form (*.example.com,
# .example.com) or an unanchored /regex/ fails startup.
# JIRA_ALLOWED_HOSTS=jira.example.com

# ---------------------------------------------------------------------------
# Profiles (optional) — several sites from one env file
# ---------------------------------------------------------------------------

# JIRA_PROFILE_<NAME>_SITE / _EMAIL / _API_TOKEN define a named profile.
# <NAME> is your own label, uppercased; WORK below is only an example.
# JIRA_PROFILE_WORK_SITE=mycompany
# JIRA_PROFILE_WORK_EMAIL=me@example.com
# JIRA_PROFILE_WORK_API_TOKEN=replace-me

# Profile used when a tool call does not name one.
# JIRA_ACTIVE_PROFILE=WORK

# Per-call profile switching is rejected unless this is 0 — locked is the
# default, so the only meaningful value to write here is the unlock.
# JIRA_LOCK_PROFILE=0

# ---------------------------------------------------------------------------
# Tool surface gating (optional)
# ---------------------------------------------------------------------------

# Profile (core | reader | all) or an explicit comma list of packages.
# JIRA_TOOL_PACKAGES=reader

# Deny list; wins over the selection above.
# JIRA_PACKAGES_DENY=issues-delete

# Packages whose write-tier tools are dropped.
# JIRA_PACKAGES_READONLY=collab

# plan = write tools describe what they would do; apply = they execute when the
# call passes apply: true. See docs/THREAT-MODEL.md for the gate contract.
# JIRA_WRITE_MODE=plan

# Opt-in for the irreversible write tier (the six deletes and the two bulk
# writes). Even with JIRA_WRITE_MODE=apply these tools refuse unless this is set.
# JIRA_ALLOW_IRREVERSIBLE=1

# ---------------------------------------------------------------------------
# Networking and limits (optional)
# ---------------------------------------------------------------------------

# JIRA_REQUEST_TIMEOUT_MS=<milliseconds per request>
# JIRA_CALL_BUDGET_MS=<milliseconds of HTTP activity per tool call>
# JIRA_HOST_CONCURRENCY=<parallel requests per host>
# JIRA_RETRY_ATTEMPTS=<max retry attempts>
# JIRA_MAX_RESULT_CHARS=<truncation budget for tool results>
# JIRA_MAX_PAGES=<page loop guard for fetchAll/searchPages>

# Directory attachment downloads are written to (and uploads read from).
# The binary attachment tools refuse without it; metadata listing works anyway.
# JIRA_MEDIA_DIR=/absolute/path/to/jira-media

# ---------------------------------------------------------------------------
# Transport (optional)
# ---------------------------------------------------------------------------

# stdio (the default) or http — the loopback Streamable HTTP transport (D101).
# http binds 127.0.0.1 only and requires JIRA_HTTP_TOKEN.
# JIRA_TRANSPORT=stdio

# Port the http transport binds on 127.0.0.1 (loopback only, never 0.0.0.0).
# JIRA_HTTP_PORT=3334

# Bearer token every http request must present. Without it the server refuses
# to start under JIRA_TRANSPORT=http (CC-30). Registered with the redactor
# whenever it is set, so it can never reach a log.
# JIRA_HTTP_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# debug | info | warn | error. All output goes to stderr; stdout is the
# MCP protocol.
# JIRA_LOG_LEVEL=info

# Optional JSONL journal of every write tool call.
# JIRA_JOURNAL_PATH=~/.local/state/jira-mcp-ai/journal.jsonl

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# 1 lifts the unit-test network fence (no test needs it; the live suite is
# scripts/verify-live.mjs, which does not read this variable).
# JIRA_LIVE_TEST=1

# Explicit env file path. Set in the *process* environment, not in an env file —
# it is what selects the file, so it cannot be read from inside one.
# JIRA_ENV_FILE=/absolute/path/to/.env
