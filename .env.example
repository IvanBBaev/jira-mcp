# jira-mcp-ai — example environment file
#
# Copy to one of the locations the server searches, in this order:
#   1. the path in JIRA_ENV_FILE
#   2. $XDG_CONFIG_HOME/jira-mcp-ai/.env  (default ~/.config/jira-mcp-ai/.env)
#   3. a project-local .env               (development only)
# Loaded with Node's process.loadEnvFile() — there is no dotenv dependency.
#
# Placeholders only. Never commit a real token: `.env` is git-ignored,
# `.env.example` is not.
#
# Defaults are deliberately NOT repeated here. docs/CONFIGURATION.md owns every
# name and default; a copy in this file would silently rot. Commented-out lines
# below show the shape of the value, not its default.

# ---------------------------------------------------------------------------
# Core credentials (required)
# ---------------------------------------------------------------------------

# Site key, host, or full URL: "mycompany", "mycompany.atlassian.net",
# or "https://mycompany.atlassian.net".
JIRA_SITE=mycompany

# Atlassian account email used for Basic auth.
JIRA_EMAIL=me@example.com

# Atlassian API token — create at id.atlassian.com > Security > API tokens.
# Secret: registered with the redactor, never logged.
JIRA_API_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Credential hygiene (optional)
# ---------------------------------------------------------------------------

# ISO date the token expires; doctor warns as the date approaches.
# JIRA_TOKEN_EXPIRES=2027-01-31

# Comma list of extra allowed hosts (Server/DC or vanity domains).
# Exact host or anchored regex — suffix matching is rejected.
# JIRA_ALLOWED_HOSTS=jira.example.com

# ---------------------------------------------------------------------------
# Profiles (optional) — several sites from one env file
# ---------------------------------------------------------------------------

# JIRA_PROFILE_<NAME>_SITE / _EMAIL / _API_TOKEN define a named profile.
# <NAME> is your own label, uppercased; WORK below is only an example.
# JIRA_PROFILE_WORK_SITE=mycompany
# JIRA_PROFILE_WORK_EMAIL=me@example.com
# JIRA_PROFILE_WORK_API_TOKEN=replace-me

# Profile used when a tool call does not name one.
# JIRA_ACTIVE_PROFILE=WORK

# When set, per-call profile switching is rejected.
# JIRA_LOCK_PROFILE=1

# ---------------------------------------------------------------------------
# Tool surface gating (optional)
# ---------------------------------------------------------------------------

# Profile (core | reader | all) or an explicit comma list of packages.
# JIRA_TOOL_PACKAGES=reader

# Deny list; wins over the selection above.
# JIRA_PACKAGES_DENY=admin

# Packages whose write-tier tools are dropped.
# JIRA_PACKAGES_READONLY=issues

# plan = write tools describe what they would do; apply = they execute when the
# call passes apply: true. See docs/THREAT-MODEL.md for the gate contract.
# JIRA_WRITE_MODE=plan

# Opt-in for the irreversible write tier (deletes). Even with
# JIRA_WRITE_MODE=apply these tools refuse unless this is set.
# JIRA_ALLOW_IRREVERSIBLE=1

# ---------------------------------------------------------------------------
# Networking and limits (optional)
# ---------------------------------------------------------------------------

# JIRA_REQUEST_TIMEOUT_MS=<milliseconds per request>
# JIRA_CALL_BUDGET_MS=<milliseconds of HTTP activity per tool call>
# JIRA_HOST_CONCURRENCY=<parallel requests per host>
# JIRA_RETRY_ATTEMPTS=<max retry attempts>
# JIRA_MAX_RESULT_CHARS=<truncation budget for tool results>
# JIRA_MAX_PAGES=<page loop guard for fetchAll/searchPages>

# Directory attachment downloads are written to (and uploads read from).
# The binary attachment tools refuse without it; metadata listing works anyway.
# JIRA_MEDIA_DIR=/absolute/path/to/jira-media

# ---------------------------------------------------------------------------
# Transport (optional)
# ---------------------------------------------------------------------------

# stdio or http.
# JIRA_TRANSPORT=stdio

# Loopback-only Streamable HTTP port.
# JIRA_HTTP_PORT=<port>

# REQUIRED when JIRA_TRANSPORT=http — the server refuses to start without it.
# JIRA_HTTP_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# debug | info | warn | error. All output goes to stderr; stdout is the
# MCP protocol.
# JIRA_LOG_LEVEL=info

# Optional JSONL journal of every write tool call.
# JIRA_JOURNAL_PATH=~/.local/state/jira-mcp-ai/journal.jsonl

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# 1 enables the live read suite against a scratch site; unset, those tests skip.
# JIRA_LIVE_TEST=1

# Explicit env file path. Set in the *process* environment, not in an env file —
# it is what selects the file, so it cannot be read from inside one.
# JIRA_ENV_FILE=/absolute/path/to/.env
