{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": [
    "src/mcp/write-mode.ts",
    "src/mcp/project-scope.ts",
    "src/mcp/taint.ts",
    "src/core/http-util.ts",
    "src/core/http/decide.ts"
  ],
  "buildCommand": "npx tsc",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "build/{cli,core,mcp,testing,tools}/**/*.test.js",
      "build/api/**/!(safe-allowlist).test.js",
      "build/!(manifest-sync).test.js"
    ],
    "nodeArgs": [
      "-r",
      "{{hookFile}}",
      "--import",
      "./build/testing/network-fence.js",
      "--test-reporter=tap",
      "{{testFile}}"
    ],
    "forceBail": true
  },
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["build", "coverage", "mcpb/dist", "reports"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 78
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
